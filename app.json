{
  "expo": {
    "name": "Shop",
    "slug": "shop-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/undraw_Thought_process_re_om58.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/undraw_Thought_process_re_om58.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.david2024.mytailwind"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "58e12e85-7e0f-46bf-8782-5345d3ef4d4c"
      }
    }
  }
}
